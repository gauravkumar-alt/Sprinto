# ─────────────────────────────────────────────────────────────
# Sprinto Outreach Agent — configuration
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# demo = missing credentials fall back to clearly-labelled MOCK providers
# live = missing credentials make that provider unavailable (stage fails with a setup message)
APP_MODE=demo

# SQLite file (created automatically)
APP_DATABASE_URL=file:./data/outreach.db

# Idempotency scope for duplicate-send prevention
CAMPAIGN_ID=sprinto-mesa-demo
SENDER_NAME=Sprinto Growth Team

# ── LLM (runtime API key — a Claude Code subscription does NOT provide one) ──
# anthropic (default model claude-opus-5-5) or gemini (default model gemini-3.8-flash)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# Gemini only: tried in order when the primary model is overloaded (503), out of quota (429) or times out
LLM_FALLBACK_MODELS=

# Qualification thresholds (100-point rubric): >= QUALIFY_THRESHOLD qualified, >= REVIEW_THRESHOLD needs review
QUALIFY_THRESHOLD=75
REVIEW_THRESHOLD=55
# false (default, Sprinto Evidence Map): companies already holding SOC 2 / ISO 27001 are flagged ALREADY_CERTIFIED and disqualified.
ALREADY_CERTIFIED_QUALIFIES=false
# low | medium | high  (cost vs. depth)
LLM_EFFORT=medium
# Server-side refusal fallback (Anthropic beta). true/false
LLM_REFUSAL_FALLBACK=true

# ── Optional external search for the research loop (Tavily). Leave empty for website-only research. ──
RESEARCH_PROVIDER=
RESEARCH_API_KEY=

# Research budget
# One homepage request, then at most this many targeted page fetches per company
RESEARCH_MAX_ADDITIONAL_PAGES=4
RESEARCH_MAX_PAGES_PER_ROUND=2
RESEARCH_MAX_ROUNDS=3
# Cleaned content sent to the model per pass (~2,000 tokens)
RESEARCH_CONTEXT_CHARS=8000
# Render JavaScript-only pages with headless Chromium (npx playwright-core install chromium-headless-shell)
RESEARCH_BROWSER_FALLBACK=true
RESEARCH_MAX_SEARCH_CALLS=2
RESEARCH_PAGE_TIMEOUT_MS=12000
RESEARCH_MAX_REDIRECTS=4
RESEARCH_MAX_CHARS_PER_PAGE=12000
RESEARCH_CACHE_HOURS=72

# ── Hunter.io Domain Search ──
HUNTER_API_KEY=
# The case cites 25 searches/month on the free tier — set this to your plan's quota
HUNTER_MONTHLY_LIMIT=25
HUNTER_CACHE_DAYS=30

# ── Gmail (server-side OAuth; scopes: gmail.send + openid email) ──
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Either paste a refresh token here, or click "Connect Gmail" in the dashboard (stored in the local DB)
GMAIL_REFRESH_TOKEN=
# Optional; if set it must equal the authenticated account
GMAIL_SENDER_EMAIL=
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# THE ONLY ADDRESS THE APP WILL EVER SEND TO. Must be the Gmail account you authorise.
DEMO_INBOX_EMAIL=

# Shared view-only link: extra hostnames allowed through the guard (read-only for them),
# e.g. *.trycloudflare.com for a Cloudflare quick tunnel
ALLOWED_HOSTS=

# Batch
BATCH_CONCURRENCY=2
BATCH_MAX_DOMAINS=50

# ---- Public read-only site (optional; see README "Public link on Vercel") ----
# The Mac publishes masked results to one Supabase table; Vercel only reads it.
# Set all three here (npm run keys -- --supabase). On Vercel set ONLY SUPABASE_URL and SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Write key — keep it on this computer only. Never put it in Vercel, GitHub or frontend code.
SUPABASE_SERVICE_ROLE_KEY=
