# ─────────────────────────────────────────────────────────────
# Sprinto Outreach Agent — configuration
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# demo = missing credentials fall back to clearly-labelled MOCK providers
# live = missing credentials make that provider unavailable (stage fails with a setup message)
APP_MODE=demo

# SQLite file (created automatically)
APP_DATABASE_URL=file:./data/outreach.db

# Idempotency scope for duplicate-send prevention
CAMPAIGN_ID=sprinto-mesa-demo
SENDER_NAME=Sprinto Growth Team

# ── LLM (runtime API key — a Claude Code subscription does NOT provide one) ──
# anthropic (default model claude-opus-5-5) or gemini (default model gemini-3.8-flash)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# Gemini only: tried in order when the primary model returns 503 (overloaded) or 429 (quota)
LLM_FALLBACK_MODELS=
# low | medium | high  (cost vs. depth)
LLM_EFFORT=medium
# Server-side refusal fallback (Anthropic beta). true/false
LLM_REFUSAL_FALLBACK=true

# ── Optional external search for the research loop (Tavily). Leave empty for website-only research. ──
RESEARCH_PROVIDER=
RESEARCH_API_KEY=

# Research budget
RESEARCH_MAX_PAGES=8
RESEARCH_MAX_PAGES_PER_ROUND=4
RESEARCH_MAX_ROUNDS=2
RESEARCH_MAX_SEARCH_CALLS=2
RESEARCH_PAGE_TIMEOUT_MS=12000
RESEARCH_MAX_REDIRECTS=4
RESEARCH_MAX_CHARS_PER_PAGE=12000
RESEARCH_CACHE_HOURS=72

# ── Hunter.io Domain Search ──
HUNTER_API_KEY=
# The case cites 25 searches/month on the free tier — set this to your plan's quota
HUNTER_MONTHLY_LIMIT=25
HUNTER_CACHE_DAYS=30

# ── Gmail (server-side OAuth; scopes: gmail.send + openid email) ──
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Either paste a refresh token here, or click "Connect Gmail" in the dashboard (stored in the local DB)
GMAIL_REFRESH_TOKEN=
# Optional; if set it must equal the authenticated account
GMAIL_SENDER_EMAIL=
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# THE ONLY ADDRESS THE APP WILL EVER SEND TO. Must be the Gmail account you authorise.
DEMO_INBOX_EMAIL=

# Batch
BATCH_CONCURRENCY=2
BATCH_MAX_DOMAINS=50
